    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "fastify": "^4.26.2",
    "argon2": "^0.40.1",
    "jsonwebtoken": "^9.0.2",
    "better-sqlite3": "^11.0.0",
    "zod": "^3.23.8",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
